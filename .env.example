# SMTP configuration for direct cPanel email backups (hello@monkeytribe.in)
SMTP_HOST=mail.monkeytribe.in
SMTP_PORT=465
SMTP_USER=hello@monkeytribe.in
SMTP_PASS=your_email_account_password_here

# Razorpay server-side payment verification
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_ALLOWED_ORIGIN=https://www.monkeytribe.in
